@model MotorFest.Models.Location.LocationViewModel

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-5">
    <h2 class="mb-4">Добави/Редактирай Локация</h2>
    <form asp-action="CreateOrEdit">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Име на Локация</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="City" class="form-label">Град</label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FullAddress" class="form-label">Пълен Адрес</label>
            <input asp-for="FullAddress" class="form-control" />
            <span asp-validation-for="FullAddress" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Municipality" class="form-label">Община</label>
            <input asp-for="Municipality" class="form-control" />
            <span asp-validation-for="Municipality" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Запази</button>
        <a asp-action="Index" class="btn btn-secondary">Назад към списъка</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
