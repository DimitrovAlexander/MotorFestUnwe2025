<div class="container mt-5">
    <h2 class="mb-4">Детайли за Локация</h2>
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text"><strong>Град:</strong> @Model.City</p>
            <p class="card-text"><strong>Пълен Адрес:</strong> @Model.FullAddress</p>
            <p class="card-text"><strong>Държава:</strong> @Model.Municipality</p>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn custom-primary-btn">Редактирай</a>
            <a asp-action="Index" class="btn custom-primary-btn">Назад към списъка</a>
        </div>
    </div>
</div>
