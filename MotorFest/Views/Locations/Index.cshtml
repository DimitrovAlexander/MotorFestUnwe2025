<div class="container mt-5">
    <h2 class="mb-4">Списък с Локации</h2>
    <a asp-action="Create" class="btn btn-success mb-3">Добави Нова Локация</a>
    <table class="table table-striped table-hover" style="color:mediumpurple">
        <thead>
            <tr>
                <th>Име</th>
                <th>Град</th>
                <th>Пълен Адрес</th>
                <th>Община</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var location in Model)
            {
                <tr>
                    <td>@location.Name</td>
                    <td>@location.City</td>
                    <td>@location.FullAddress</td>
                    <td>@location.Municipality</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@location.Id" class="btn btn-warning btn-sm">Редактирай</a>
                        <a asp-action="Details" asp-route-id="@location.Id" class="btn btn-info btn-sm">Детайли</a>
                        <a asp-action="Delete" asp-route-id="@location.Id" class="btn btn-danger btn-sm">Изтрий</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
