@using X.PagedList
@model IPagedList<MotorFest.Models.Location.LocationViewModel>

<div class="container mt-5">
	<h2 class="mb-4">Списък с Локации</h2>

	<!-- Search Form -->
	<form asp-action="Index" method="get" class="form-inline mb-3">
		<input type="text" name="searchString" class="form-control mr-sm-2" placeholder="Търсене по име, град или община" value="@ViewData["CurrentFilter"]" />
		<button type="submit" class="btn custom-primary-btn mt-1">Търсене</button>
		<a asp-action="Index" class="btn custom-primary-btn">Изчисти търсенето</a>

	</form>

	<a asp-action="Create" class="btn custom-primary-btn mb-3">Добави Нова Локация</a>
	<table class="table table-striped table-hover">
		<thead>
			<tr>
				<th>Име</th>
				<th>Град</th>
				<th>Пълен Адрес</th>
				<th>Община</th>
				<th>Действия</th>
				@if (User.IsInRole("Administrator"))
				{
					<th>Последна промяна</th>
				}
			</tr>
		</thead>
		<tbody>
			@foreach (var location in Model)
			{
				<tr>
					<td>@location.Name</td>
					<td>@location.City</td>
					<td>@location.FullAddress</td>
					<td>@location.Country</td>
					<td>
						<a asp-action="Details" asp-route-id="@location.Id" class="btn custom-primary-btn btn-sm">Детайли</a>
						<a asp-action="Delete" asp-route-id="@location.Id" class="btn custom-primary-btn btn-sm">Изтрий</a>
						<a asp-action="Edit" asp-route-id="@location.Id" class="btn custom-primary-btn btn-sm">Редактирай</a>
					</td>
					@if (User.IsInRole("Administrator"))
					{
						<td>@location.LastUpdate</td>
					}
				</tr>
			}
		</tbody>
	</table>

	<!-- Pagination Controls -->
	<div class="pagination justify-content-center">
		@Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewData["CurrentFilter"] }),
					new PagedListRenderOptions
		{
				UlElementClasses = new List<string> { "pagination" },
		LiElementClasses = new List<string> { "page-item" },
		PageClasses = new List<string> { "page-link" }
		})
	</div>
</div>
