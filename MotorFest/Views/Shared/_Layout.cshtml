<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - MotorFest</title>
	<script type="importmap"></script>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/MotorFest.styles.css" asp-append-version="true" />
</head>
<body>
	@if (ViewData["ShowLoadingScreen"] as bool? == true)
	{
		<div id="loading-screen">
			<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/1.18.3/TweenMax.min.js"></script>
			<script src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/16327/MorphSVGPlugin.min.js"></script>
			<svg class="mainSVG" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<path id="puff" d="M4.5,8.3C6,8.4,6.5,7,6.5,7s2,0.7,2.9-0.1C10,6.4,10.3,4.1,9.1,4c2-0.5,1.5-2.4-0.1-2.9c-1.1-0.3-1.8,0-1.8,0
	s-1.5-1.6-3.4-1C2.5,0.5,2.1,2.3,2.1,2.3S0,2.3,0,4.4c0,1.1,1,2.1,2.2,2.1C2.2,7.9,3.5,8.2,4.5,8.3z" fill="#fff" />
					<circle id="dot" cx="0" cy="0" r="5" fill="#fff" />
				</defs>

				<circle id="mainCircle" fill="none" stroke="none" stroke-width="2" stroke-miterlimit="10" cx="400" cy="300" r="130" />
				<circle id="circlePath" fill="none" stroke="none" stroke-width="2" stroke-miterlimit="10" cx="400" cy="300" r="80" />

				<g id="mainContainer">
					<g id="car">
						<path id="carRot" fill="#FFF" d="M45.6,16.9l0-11.4c0-3-1.5-5.5-4.5-5.5L3.5,0C0.5,0,0,1.5,0,4.5l0,13.4c0,3,0.5,4.5,3.5,4.5l37.6,0
	C44.1,22.4,45.6,19.9,45.6,16.9z M31.9,21.4l-23.3,0l2.2-2.6l14.1,0L31.9,21.4z M34.2,21c-3.8-1-7.3-3.1-7.3-3.1l0-13.4l7.3-3.1
	C34.2,1.4,37.1,11.9,34.2,21z M6.9,1.5c0-0.9,2.3,3.1,2.3,3.1l0,13.4c0,0-0.7,1.5-2.3,3.1C5.8,19.3,5.1,5.8,6.9,1.5z M24.9,3.9
	l-14.1,0L8.6,1.3l23.3,0L24.9,3.9z" />
					</g>
				</g>
			</svg>


		</div>
	}


	<header>
		<nav class="navbar navbar-expand-sm mb-2" style="background-color: #38385E">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MotorFest</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav flex-grow-1">
						<li class="nav-item">
							<a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Начало</a>
						</li>
						@if (User.IsInRole("Organizer") || User.IsInRole("Administrator"))
						{
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Locations" asp-action="Index">Адреси</a>
							</li>
						}
						@if (User.IsInRole("Participant") || User.IsInRole("Administrator"))
						{
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Vehicles" asp-action="Index">Превозни средства</a>
							</li>
						}
						@if (User.IsInRole("Organizer") || User.IsInRole("Administrator"))
						{
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Events" asp-action="Index">Събития</a>
							</li>

						}
						@if (User.IsInRole("Participant") || User.IsInRole("Administrator"))
						{
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Events" asp-action="Calendar">Календар на събитията</a>
							</li>

							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Events" asp-action="MyEvents">Моите събития</a>
							</li>
						}
						@if (User.IsInRole("Administrator"))
						{
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="UsersView" asp-action="Index">Потребители</a>
							</li>
						}
					</ul>
					<partial name="_LoginPartial" />
				</div>
			</div>
		</nav>
	</header>
	<div class="fade-container">
		<div class="container screen">
			<main role="main" class="pb-3">
				@RenderBody()
			</main>
		</div>
	</div>

	<footer class="border-top footer" style="background-color: #38385E">
		<p>
			&copy; 2025 - MotorFest
		</p>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/loading.js" asp-append-version="true"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
