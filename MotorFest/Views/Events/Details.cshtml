 *@
 @model MotorFest.Models.Event.EventViewModel

<div class="container mt-5">
	<div class="event-header text-center mb-4">
		<h1 class="event-title"> @Model.Name</h1>
		<p class="event-date">📅 @Model.EventDate.ToShortDateString()</p>
		<img src="@Model.EventLogo" alt="Снимка на събитието" class="event-logo img-fluid rounded shadow">
	</div>

	<div class="row">
		<div class="col-lg-8">
			@if (Model.EventPhotos != null && Model.EventPhotos.Any())
			{
				<div id="eventCarousel" class="carousel slide" data-bs-ride="carousel">
					<div class="carousel-inner">
						@{
							var photosList = Model.EventPhotos.ToList();
						}
						@for (int i = 0; i < photosList.Count; i++)
						{
							<div class="carousel-item @(i == 0 ? "active" : "")">
								<img src="@photosList[i]" class="d-block w-100 rounded shadow-lg" alt="Снимка от събитието">
							</div>
						}
					</div>
					<button class="carousel-control-prev" type="button" data-bs-target="#eventCarousel" data-bs-slide="prev">
						<span class="carousel-control-prev-icon"></span>
					</button>
					<button class="carousel-control-next" type="button" data-bs-target="#eventCarousel" data-bs-slide="next">
						<span class="carousel-control-next-icon"></span>
					</button>
				</div>
			}
		</div>

		<div class="col-lg-4">
			<div class="event-info p-4 rounded shadow">
				<h4>ℹ Детайли за събитието</h4>
				<p><strong>Място: </strong>@Model.Location.City, @Model.Location.FullAddress</p>
				<p><strong>Описание:</strong> @Model.Description</p>

				<p><strong>Мин. година:</strong> @Model.MinYearOfManufacture</p>
				<p><strong>Макс. година:</strong> @Model.MaxYearOfManufacture</p>
				<h5>Категории превозни средства:</h5>
				<ul>
					@foreach (var category in Model.VehicleCategories.Where(c => c.IsChecked))
					{
						<li>🚗 @category.CategoryName</li>
					}
				</ul>
				<h5>Типове двигатели:</h5>
				<ul>
					@foreach (var type in Model.EngineTypes.Where(c => c.IsChecked))
					{
						<li>⚙ @type.CategoryName</li>
					}
				</ul>
			</div>
		</div>
	</div>

	@if (ViewData["RegisteredVehicles"] != null)
	{
		<h3 class="text-center mt-5">Записани участници</h3>
		<table class="table table-striped table-hover shadow-lg rounded">
			<thead>
				<tr>
					<th>Производител</th>
					<th>Модел</th>
					<th>Година</th>
					<th>Собственик</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var vehicle in (IEnumerable<MotorFest.Models.Vehicle.VehicleViewModel>)ViewData["RegisteredVehicles"])
				{
					<tr>
						<td>@vehicle.Manufacturer</td>
						<td>@vehicle.Model</td>
						<td>@vehicle.YearOfManufacture</td>
						<td>@vehicle.Owner.Firstname @vehicle.Owner.Lastname</td>
					</tr>
				}
			</tbody>
		</table>
	}

	<div class="text-center mt-4">
		<a asp-action="Index" class="btn custom-secondary-btn">Назад</a>
		@if (User.IsInRole("Administrator") || User.IsInRole("Participant"))
		{

			@if (!(bool)ViewData["IsRegistered"])
			{
				<a asp-action="Subscribe" asp-route-id="@Model.Id" class="btn custom-primary-btn btn-lg">Запиши се!</a>
			}
		}
	</div>
</div>

