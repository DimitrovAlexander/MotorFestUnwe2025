@model MotorFest.Models.Event.EventViewModel

<h1>Информация за събитието</h1>

<div>
	<h3>@Model.Name</h3>
	<p>Дата: @Model.EventDate.ToShortDateString()</p>
	<p>Входна такса: @Model.EntranceFee</p>
	<p>Разрешени превозни средства за участие:</p>
	<ul>
		@foreach (var category in Model.VehicleCategories.Where(c => c.IsChecked))
		{
			<li>@category.CategoryName</li>
		}
	</ul>
</div>

<a asp-action="Index" class="btn btn-secondary">Върни се назад</a>
<a asp-action="Subscribe" asp-route-id="@Model.Id" class="btn btn-info">Запиши се</a>

