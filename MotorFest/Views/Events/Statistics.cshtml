@using X.PagedList
@model IPagedList<MotorFest.Models.Event.EventsViewViewModel>

<div class="container mt-5">
    <h2 class="mb-4 text-center">📊 Статистика на събитията</h2>

    <!-- Toggle View Button -->
    <div class="d-flex justify-content-end mb-3">
        <a id="toggleView" class="menu-button js-button fade-fly-in">
            <span class="button__inner">
                <span class="button__text js-button__text">Превключи изгледа</span>
                <span class="button__hover js-button__hover">Превключи изгледа</span>
            </span>
        </a>

    </div>

    <!-- Search Form -->
    <form asp-action="Index" method="get" class="d-flex justify-content-center mb-4">
        <input type="text" name="searchString" class="form-control w-50 mr-2" placeholder="🔍 Търсене по име, локация или организатор" value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn btn-primary">Търсене</button>
        <a asp-action="Index" class="btn custom-secondary-btn ml-2">Изчисти</a>
    </form>

    <!-- Table View -->
    <div id="tableView" class="d-none">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Събитие</th>
                    @if (User.IsInRole("Administrator"))
                    {
                        <th>Организатор</th>
                    }
                    <th>Локация</th>
                    <th>Дата</th>
                    <th>Вход</th>
                    <th>Регистрирани</th>
                    <th>Очаквани приходи</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evnt in Model)
                {
                    <tr>
                        <td>@evnt.EventName</td>
                        @if (User.IsInRole("Administrator"))
                        {
                        <td>@evnt.OrganizerFullName</td>
                        }
                        <td>@evnt.LocationName</td>
                        <td>@evnt.EventDate.ToShortDateString()</td>
                        <td>
                            @if (evnt.EntranceFee == 0)
                            {
                                <span class="badge bg-success">Безплатно</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@evnt.EntranceFee лв</span>
                            }
                        </td>
                        <td>@evnt.RegisteredParticipantsCount</td>
                        <td>@evnt.ExpectedRevenue лв</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@evnt.EventId" class="btn btn-outline-primary btn-sm">ℹ️ Детайли</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Card View -->
    <div id="cardViews" class="row d-none">
        
        @foreach (var evnt in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title text-center">🚗 @evnt.EventName</h5>
                        @if (User.IsInRole("Administrator"))
                        {
                        <p class="text-muted text-center">@evnt.OrganizerFullName</p>
                        }
                        <hr>
                        <p><i class="bi bi-geo-alt-fill text-danger"></i> <strong>Локация:</strong> @evnt.LocationName</p>
                        <p><i class="bi bi-calendar-event text-primary"></i> <strong>Дата:</strong> @evnt.EventDate.ToShortDateString()</p>
                        <p>
                            <i class="bi bi-ticket-detailed text-success"></i>
                            <strong>Вход:</strong>
                            @if (evnt.EntranceFee == 0)
                            {
                                <span class="badge bg-success">Безплатно</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@evnt.EntranceFee лв</span>
                            }
                        </p>
                        <p><i class="bi bi-people text-info"></i> <strong>Регистрирани:</strong> @evnt.RegisteredParticipantsCount</p>
                        <p><i class="bi bi-cash-coin text-warning"></i> <strong>Очаквани приходи:</strong> @evnt.ExpectedRevenue лв</p>
                        <div class="text-center mt-3">
                            <a asp-action="Details" asp-route-id="@evnt.EventId" class="btn btn-outline-primary btn-sm">ℹ️ Детайли</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>


    <!-- Pagination Controls -->
    <div class="pagination justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Statistics", new { page, searchString = ViewData["CurrentFilter"] }),
                 new PagedListRenderOptions
        {
            UlElementClasses = new List<string> { "pagination" },
            LiElementClasses = new List<string> { "page-item" },
            PageClasses = new List<string> { "page-link" }
        })
    </div>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="infoToast" class="toast fade" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">MotorFest</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            Ако нужда от помощ и съдействие, моля свържете се с администратор на адрес info.motorfest@gmail.com.
        </div>
    </div>
</div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tableView = document.getElementById("tableView");
            const cardsView = document.getElementById("cardViews"); // <-- Тук е с "s"
            const toggleBtn = document.getElementById("toggleView");

            // Check the last selected view mode
            let currentView = localStorage.getItem("viewModeStatistics") || "table";
            updateView(currentView);

            toggleBtn.addEventListener("click", function () {
                currentView = (currentView === "table") ? "cards" : "table";
                localStorage.setItem("viewModeStatistics", currentView);
                updateView(currentView);
            });

            function updateView(viewMode) {
                if (viewMode === "table") {
                    tableView.classList.remove("d-none");
                    cardsView.classList.add("d-none");
                } else {
                    tableView.classList.add("d-none");
                    cardsView.classList.remove("d-none");
                }
            }
        });

        document.addEventListener("DOMContentLoaded", function () {
            var toastEl = document.getElementById("infoToast");
            if (toastEl) {
                var toast = new bootstrap.Toast(toastEl);
                toast.show();
            }
        });

 
</script>


