@model ICollection<MotorFest.Models.Event.EventViewModel>

<h1>Моите събития</h1>

<table class="table">
	<thead>
		<tr>
			<th>Име на събитието</th>
			<th>Дата на събитието</th>
			<th>Входна такса</th>
			<th>Има ли записани участници вече?</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.Name</td>
				<td>@item.EventDate.ToShortDateString()</td>
				<td>@item.EntranceFee</td>

				<td>
					@if (!item.HasVehicles)
					{
						<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info">Редактирай</a>
					}
					<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Детайли</a>
					<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Изтрий</a>
				</td>
			</tr>
		}
	</tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Create New Event</a>

