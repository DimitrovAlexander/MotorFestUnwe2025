@model ICollection<MotorFest.Models.Event.EventViewModel>

<h1>Моите събития</h1>

<a asp-action="Create" class="btn custom-btn">Добави събитие</a>

<table class=" table table-striped table-hover">
	<thead>
		<tr>
			<th>Име на събитието</th>
			<th>Дата на събитието</th>
			<th>Входна такса</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.Name</td>
				<td>@item.EventDate.ToShortDateString()</td>
				<td>@item.EntranceFee</td>

				<td>
					<a asp-action="Details" asp-route-id="@item.Id" class="btn custom-btn">Детайли</a>
					@if (!item.HasVehicles)
					{
						<a asp-action="Delete" asp-route-id="@item.Id" class="btn custom-btn">Изтрий</a>
						<a asp-action="Edit" asp-route-id="@item.Id" class="btn custom-btn">Редактирай</a>
					}
				</td>
			</tr>
		}
	</tbody>
</table>


