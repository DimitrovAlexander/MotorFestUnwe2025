@using X.PagedList
@model IPagedList<MotorFest.Models.Event.EventViewModel>
@{
	var successMessage = TempData["successMessage"]?.ToString();
}

<div class="container mt-5">
	<div class="d-flex justify-content-between align-items-center mb-4 fade-fly-in">
		<h2 class="fade-fly-in">📅 Моите събития</h2>
		<div class="d-flex justify-content-end mb-3 fade-fly-in">
			<a id="toggleViewBtn" class="menu-button js-button fade-fly-in d-inline-block mx-auto fade-fly-in">
				<span class="button__inner">
					<span class="button__text js-button__text">Превключи изглед</span>
					<span class="button__hover js-button__hover">Превключи изглед</span>
				</span>
			</a>

		</div>
	</div>

	<form asp-action="Index" method="get" class="d-flex justify-content-center mb-4 fade-fly-in">
		<input type="text" name="searchString" class="form-control w-50 mr-2" placeholder="🔍 Търсене по име, локация, дата..." value="@ViewData["CurrentFilter"]" />
		<button type="submit" class="btn custom-primary-btn">Търсене</button>
		<a asp-action="Index" class="btn custom-secondary-btn ml-2">Изчисти</a>
	</form>

	@if (!string.IsNullOrEmpty(successMessage))
	{
		<div class="alert alert-success fade-fly-in">@successMessage</div>
	}
	<a asp-action="Create" class="menu-button js-button d-inline-block mx-auto fade-fly-in  mb-4">
		<span class="button__inner">
			<span class="button__text js-button__text">Добави събитие</span>
			<span class="button__hover js-button__hover">Добави събитие</span>
		</span>
	</a>

	<div id="tableView" class="view-container fade-fly-in">
		<table class="table table-striped table-hover">
			<thead>
				<tr>
					<th>Лого</th>
					<th>Име</th>
					<th>Дата</th>
					<th>Такса</th>
					<th>Статус</th>
					<th>Действия</th>
					@if (User.IsInRole("Administrator"))
					{
						<th>Последна промяна</th>
						<th>Организатор</th>
					}
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td><img src="@item.EventLogo" class="img-thumbnail small-image" /></td>
						<td>@item.Name</td>
						<td>@item.EventDate.ToShortDateString()</td>
						<td>@(item.EntranceFee == 0 ? "Вход свободен" : $"{item.EntranceFee} лв")</td>
						<td>
							<span class="badge @(item.IsCanceled ? "bg-danger" : "bg-info")">
								@(item.IsCanceled ? "Отменено" : "Активно")
							</span>
						</td>
						<td>
							<div class="d-flex gap-1">
								<a asp-action="Details" asp-route-id="@item.Id" class="btn custom-primary-btn btn-sm">Детайли</a>
								@if (item.EventDate > DateTime.UtcNow)
								{

									@if (!item.HasVehicles)
									{
										<a asp-action="Delete" asp-route-id="@item.Id" class="btn custom-primary-btn btn-sm">Изтрий</a>
										<a asp-action="Edit" asp-route-id="@item.Id" class="btn custom-primary-btn btn-sm">Редактирай</a>
									}
									else if (item.IsCanceled)
									{
										<a asp-action="Cancel" asp-route-id="@item.Id" class="btn custom-primary-btn btn-sm">Поднови</a>
									}
									else
									{
										<a asp-action="Cancel" asp-route-id="@item.Id" class="btn custom-primary-btn btn-sm">Отмени</a>
									}
								}
								else
								{
									<a asp-action="Delete" asp-route-id="@item.Id" class="btn custom-primary-btn btn-sm">Изтрий</a>
								}
							</div>
						</td>
						@if (User.IsInRole("Administrator"))
						{
							<td>@item.LastUpdate</td>
							<td>@item.Organizer.Firstname @item.Organizer.Lastname</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div id="cardView" class="row view-container fade-fly-in" style="display: none;">
		@foreach (var item in Model)
		{
			<div class="col-md-4 col-sm-6 mb-4">
				<div class="card shadow-sm h-100 @(item.IsCanceled ? "bg-light text-muted" : "")">
					<img src="@item.EventLogo" class="card-img-top event-image" alt="Събитие">
					<div class="card-body text-center d-flex flex-column mt-auto">
						<h5 class="card-title mt-auto">@item.Name</h5>
						<p class="text-muted"><i class="bi bi-calendar"></i> @item.EventDate.ToShortDateString()</p>
						@if (User.IsInRole("Administrator"))
						{
							<p class="card-title mt-auto"><i class="bi bi-person"></i>Ораганизатор:</p>
							<p class="text-muted"><i class="bi bi-person"></i>@item.Organizer.Firstname @item.Organizer.Lastname</p>
						}
						<p>
							@if (item.EntranceFee == 0)
							{
								<span class="badge bg-success">Вход свободен</span>
							}
							else
							{
								<span class="badge bg-primary">@item.EntranceFee лв</span>
							}
						</p>

						<p>
							@if (item.IsCanceled)
							{
								<span class="badge bg-danger"><i class="bi bi-x-circle"></i> Отменено</span>
							}
							else
							{
								<span class="badge bg-info"><i class="bi bi-check-circle"></i> Активно</span>
							}
						</p>

						<div class="d-flex justify-content-center mt-auto">
							<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm mx-1">ℹ️ Детайли</a>

							@if (!item.HasVehicles)
							{
								<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm mx-1">✏️ Редакция</a>
								<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm mx-1">🗑 Изтрий</a>
							}
							else if (item.IsCanceled)
							{
								<a asp-action="Cancel" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm mx-1">🔄 Поднови</a>
							}
							else
							{
								<a asp-action="Cancel" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm mx-1">🚫 Отмени</a>
							}
						</div>

						@if (User.IsInRole("Administrator"))
						{
							<p class="text-muted mt-2"><i class="bi bi-clock-history"></i> Последна промяна: @item.LastUpdate</p>
						}
					</div>
				</div>
			</div>

		}
	</div>

	
	<div class="pagination justify-content-center fade-fly-in">
		@Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewData["CurrentFilter"] }),
					new PagedListRenderOptions
		{
			UlElementClasses = new List<string> { "pagination" },
			LiElementClasses = new List<string> { "page-item" },
			PageClasses = new List<string> { "page-link" }
		})
	</div>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3">
	<div id="infoToast" class="toast fade" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="toast-header">
			<strong class="me-auto">MotorFest</strong>
			<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
		</div>
		<div class="toast-body">
			Ако нужда от помощ и съдействие, моля свържете се с администратор на адрес info.motorfest@gmail.com.
		</div>
	</div>
</div>


<script>
	 document.addEventListener("DOMContentLoaded", function () {

			var toastEl = document.getElementById("infoToast");
			if (toastEl) {
				console.log("Toast елементът е намерен!"); // Дебъг
				var toast = new bootstrap.Toast(toastEl);
				toast.show();

			} else {
				console.error("Toast елементът не е намерен!"); // Дебъг
			}

	});
	document.addEventListener("DOMContentLoaded", function () {
		const tableView = document.getElementById("tableView");
		const cardView = document.getElementById("cardView");
		const toggleBtn = document.getElementById("toggleViewBtn");

		// Проверяваме последно избрания изглед
		let currentView = localStorage.getItem("viewMode") || "table";
		updateView(currentView);

		toggleBtn.addEventListener("click", function () {
			currentView = (currentView === "table") ? "card" : "table";
			localStorage.setItem("viewMode", currentView);
			updateView(currentView);
		});

		function updateView(viewMode) {
			if (viewMode === "table") {
				tableView.style.display = "block";
				cardView.style.display = "none";
			} else {
				tableView.style.display = "none";
				cardView.style.display = "flex";  
			}
		}
	});
</script>

