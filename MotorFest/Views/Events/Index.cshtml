@using X.PagedList
@model IPagedList<MotorFest.Models.Event.EventViewModel>

<div class="container mt-5">
    <h2 class="mb-4">Моите събития</h2>

    <!-- Search Form -->
    <form asp-action="Index" method="get" class="form-inline mb-3">
        <input type="text" name="searchString" class="form-control mr-sm-2" placeholder="Търсене по име на събитие, локация, дата, категория или вид на двигателя" value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn custom-btn mt-1">Търсене</button>
    </form>

    <a asp-action="Create" class="btn custom-btn mb-3">Добави събитие</a>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Име на събитието</th>
                <th>Дата на събитието</th>
                <th>Входна такса</th>
                <th>Действия</th>
                @if (User.IsInRole("Administrator"))
                {
                    <th>Последна промяна</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.EventDate.ToShortDateString()</td>
                    <td>@item.EntranceFee</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn custom-btn btn-sm">Детайли</a>
                        @if (!item.HasVehicles)
                        {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn custom-btn btn-sm">Изтрий</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn custom-btn btn-sm">Редактирай</a>
                        }
                    </td>
                    @if (User.IsInRole("Administrator"))
                    {
                        <td>@item.LastUpdate</td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Controls -->
    <div class="pagination justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewData["CurrentFilter"] }),
                 new PagedListRenderOptions
        {
            UlElementClasses = new List<string> { "pagination" },
            LiElementClasses = new List<string> { "page-item" },
            PageClasses = new List<string> { "page-link" }
        })
    </div>
</div>