@model IEnumerable<MotorFest.Models.Event.EventViewModel>

<div class="container mt-5">
	<h2 class="mb-4 text-center">Календар на събитията</h2>

	@foreach (var eventGroup in Model.GroupBy(e => e.EventDate.Date))
	{
		<div class="card mb-4 shadow">
			<div class="card-header ">
				<h4 class="mb-0">@eventGroup.Key.ToString("dd MMM yyyy")</h4>
			</div>
			<div class="card-body">
				<div class="row">
					@foreach (var ev in eventGroup)
					{
						<div class="col-md-6 col-lg-4 mb-3">
							<div class="card event-card">
								<img src="@ev.EventLogo" class="card-img-top img-fluid rounded-top" alt="Снимка на събитието">
								<div class="card-body">
									<h5 class="card-title">@ev.Name</h5>
									@if (User.IsInRole("Administrator"))
									{
										<p class="card-title mt-auto"><i class="bi bi-person"></i>Ораганизатор:</p>
										<p class="text-muted"><i class="bi bi-person"></i>@ev.Organizer.Firstname @ev.Organizer.Lastname</p>
									}
									<p class="card-text">
										@if (ev.EntranceFee == 0)
										{
											<span class="text-success">Вход свободен</span>
										}
										else
										{
											<span class="text-danger">Вход: @ev.EntranceFee лв.</span>
										}
									</p>
									<a asp-action="Details" asp-route-id="@ev.Id" class="btn btn-primary w-100">Детайли</a>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	}

	<div class="text-center">
		<a asp-action="Index" class="btn custom-primary-btn mt-3">Назад</a>
	</div>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3">
	<div id="infoToast" class="toast fade" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="toast-header">
			<strong class="me-auto">MotorFest</strong>
			<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
		</div>
		<div class="toast-body">
			Ако нужда от помощ и съдействие, моля свържете се с администратор на адрес info.motorfest@gmail.com.
		</div>
	</div>
</div>
<script>
	 document.addEventListener("DOMContentLoaded", function () {

			var toastEl = document.getElementById("infoToast");
			if (toastEl) {
				console.log("Toast елементът е намерен!"); // Дебъг
				var toast = new bootstrap.Toast(toastEl);
				toast.show();

			} else {
				console.error("Toast елементът не е намерен!"); // Дебъг
			}

	});
</script>