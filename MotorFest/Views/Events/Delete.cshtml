@model MotorFest.Models.Event.EventViewModel


<h1>Изтрий Събитието</h1>

<p>Сигурни ли сте, че искате да изтриете събитието?</p>
<div>
    <h3>@Model.Name</h3>
    <p>Дата: @Model.EventDate.ToShortDateString()</p>
    <p>Входна такса: @Model.EntranceFee</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Изтрий</button>
    <a asp-action="Index" class="btn custom-secondary-btn">Върни се назад</a>
</form>
