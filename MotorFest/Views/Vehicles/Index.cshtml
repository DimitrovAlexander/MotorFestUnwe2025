@model IEnumerable<MotorFest.Models.Vehicle.VehicleViewModel>

@{
	ViewData["Title"] = "Index";
	var successMessage = TempData["successMessage"]?.ToString();
}

<h1>Превозни средства</h1>

@if (!string.IsNullOrEmpty(successMessage))
{
	<div class="alert alert-success" role="alert">
		@successMessage
	</div>
}
<p>
	<a asp-action="Create" class="btn custom-btn">Добави нов автомобил</a>
</p>
<table class="table table-striped table-hover">
	<thead>
		<tr>
			@if (User.IsInRole("Administrator"))
			{
				<th>
					@Html.DisplayNameFor(model => model.OwnerId)
				</th>
			}
			<th>
				@Html.DisplayNameFor(model => model.Manufacturer)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Model)
			</th>
			<th class="year-column">
				@Html.DisplayNameFor(model => model.YearOfManufacture)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Photo)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Category)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.EngineType)
				@if (User.IsInRole("Administrator"))
				{

				<th>
						@Html.DisplayNameFor(model => model.LastUpdate)
				</th>
				}
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				@if (User.IsInRole("Administrator"))
				{
					<td>
						@Html.DisplayFor(modelItem => item.OwnerId)
					</td>
				}
				<td>
					@Html.DisplayFor(modelItem => item.Manufacturer)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Model)
				</td>
				<td class="year-column">
					@Html.DisplayFor(modelItem => item.YearOfManufacture)
				</td>
				<td>

					<img src="@item.Photo" alt="Снимка на МПС" class="img-thumbnail small-image" />
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Category.Name)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.EngineType.Name)
				</td>
				@if (User.IsInRole("Administrator"))
				{

					<td>
						@Html.DisplayFor(modelItem => item.LastUpdate)
					</td>
				}
				<td>
					<a asp-action="Details" asp-route-id="@item.Id" class="btn custom-btn btn-sm">Детайли за автомобила</a> |
					<a asp-action="Delete" asp-route-id="@item.Id" class="btn custom-btn btn-sm">Изтрий</a>
					<a asp-action="Edit" asp-route-id="@item.Id" class="btn custom-btn btn-sm">Редактирай</a> |
				</td>
			</tr>
		}
	</tbody>
</table>
