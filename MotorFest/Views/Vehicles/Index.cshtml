@using X.PagedList
@model IPagedList<MotorFest.Models.Vehicle.VehicleViewModel>
@{
    var successMessage = TempData["successMessage"]?.ToString();
    Dictionary<int, bool> isVehicleInFutureEvents = (Dictionary<int, bool>)ViewData["carDictionary"];
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">🚗 Превозни средства</h2>

    <!-- Search Form -->
    <form asp-action="Index" method="get" class="d-flex justify-content-center mb-4">
        <input type="text" name="searchString" class="form-control w-50 mr-2" placeholder="🔍 Търсене по модел, марка, година, категория или вид на двигателя" value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn btn-primary">Търсене</button>
        <a asp-action="Index" class="btn custom-secondary-btn ml-2">Изчисти</a>
    </form>

    <!-- Toggle View Buttons -->
    <div id="toggleView" class="d-flex justify-content-end mb-3">
        <a class="menu-button js-button fade-fly-in">
            <span class="button__inner">
                <span class="button__text js-button__text">Превключи изгледа</span>
                <span class="button__hover js-button__hover">Превключи изгледа</span>
            </span>
        </a>
        @* <button id="toggleView" class="btn btn-primary">Превключи изглед</button> *@
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <a asp-action="Create" class="btn btn-primary mb-3">➕ Добави нов автомобил</a>

    <!-- Table View -->
    <div id="tableView">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Производител</th>
                    <th>Модел</th>
                    <th>Година</th>
                    <th>Снимка</th>
                    <th>Категория</th>
                    <th>Вид на двигателя</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Manufacturer</td>
                        <td>@item.Model</td>
                        <td>@item.YearOfManufacture</td>
                        <td><img src="@item.Photo" class="img-thumbnail small-image" /></td>
                        <td>@item.Category.Name</td>
                        <td>@item.EngineType.Name</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">ℹ️ Детайли</a>
                            @if (isVehicleInFutureEvents.ContainsKey(item.Id) && !isVehicleInFutureEvents[item.Id])
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">✏️ Редактирай</a>
                            }
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">🗑️ Изтрий</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Cards View -->
    <div id="cardsView" class="row d-none">
        @foreach (var item in Model)
        {
            <div class="col-md-4 col-sm-6 mb-4">
                <div class="card shadow-sm mb-4">
                    <img src="@item.Photo" class="card-img-top" alt="Снимка на @item.Model">
                    <div class="card-body text-center d-flex flex-column mt-auto">
                        <h5 class="card-title">🚗 @item.Manufacturer @item.Model</h5>
                        <p class="text-muted">Година: @item.YearOfManufacture</p>
                        <p><strong>Категория:</strong> @item.Category.Name</p>
                        <p><strong>Вид на двигателя:</strong> @item.EngineType.Name</p>
                        <div class="d-flex justify-content-center mt-auto">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">ℹ️ Детайли</a>
                            @if (isVehicleInFutureEvents.ContainsKey(item.Id) && !isVehicleInFutureEvents[item.Id])
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">✏️ Редактирай</a>
                            }
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">🗑️ Изтрий</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination Controls -->
    <div class="pagination justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewData["CurrentFilter"] }),
                 new PagedListRenderOptions
        {
            UlElementClasses = new List<string> { "pagination" },
            LiElementClasses = new List<string> { "page-item" },
            PageClasses = new List<string> { "page-link" }
        })
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const tableView = document.getElementById("tableView");
        const cardsView = document.getElementById("cardsView");
        const toggleBtn = document.getElementById("toggleView");

        // Check the last selected view mode
        let currentView = localStorage.getItem("viewMode") || "table";
        updateView(currentView);

        toggleBtn.addEventListener("click", function () {
            currentView = (currentView === "table") ? "cards" : "table";
            localStorage.setItem("viewMode", currentView);
            updateView(currentView);
        });

        function updateView(viewMode) {
            if (viewMode === "table") {
                tableView.classList.remove("d-none");
                cardsView.classList.add("d-none");
            } else {
                tableView.classList.add("d-none");
                cardsView.classList.remove("d-none");
            }
        }
    });
</script>
