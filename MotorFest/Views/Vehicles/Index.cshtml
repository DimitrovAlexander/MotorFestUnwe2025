@using X.PagedList
@model IPagedList<MotorFest.Models.Vehicle.VehicleViewModel>
@{

    var successMessage = TempData["successMessage"]?.ToString();
    Dictionary<int, bool> isVehicleInFutureEvents = (Dictionary<int, bool>)ViewData["carDictionary"];
}

<div class="container mt-5">
    <h2 class="mb-4">Превозни средства</h2>


    <form asp-action="Index" method="get" class="form-inline mb-3">
        <input type="text" name="searchString" class="form-control mr-sm-2" placeholder="Търсене по модел, марка, година, категория или вид на двигателя" value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn custom-btn mt-1">Търсене</button>
    </form>

    @if (!string.IsNullOrEmpty(TempData["successMessage"]?.ToString()))
    {
        <div class="alert alert-success" role="alert">
            @TempData["successMessage"]
        </div>
    }

    <a asp-action="Create" class="btn custom-btn mb-3">Добави нов автомобил</a>
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                @if (User.IsInRole("Administrator"))
                {
                    <th>Собственик</th>
                }
                <th>Производител</th>
                <th>Модел</th>
                <th class="year-column">Година на производство</th>
                <th>Снимка</th>
                <th>Категория</th>
                <th>Вид на двигателя</th>
                <th>Действия</th>
                @if (User.IsInRole("Administrator"))
                {
                    <th>Последна промяна</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @if (User.IsInRole("Administrator"))
                    {
                        <td>@item.Owner.Firstname @item.Owner.Lastname</td>
                    }
                    <td>@item.Manufacturer</td>
                    <td>@item.Model</td>
                    <td class="year-column">@item.YearOfManufacture</td>
                    <td><img src="@item.Photo" alt="Снимка на МПС" class="img-thumbnail small-image" /></td>
                    <td>@item.Category.Name</td>
                    <td>@item.EngineType.Name</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn custom-btn btn-sm">Детайли</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn custom-btn btn-sm">Изтрий</a>
                        @if (isVehicleInFutureEvents.ContainsKey(item.Id) && !isVehicleInFutureEvents[item.Id])
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn custom-btn btn-sm">Редактирай</a>
                        }
                    </td>
                    @if (User.IsInRole("Administrator"))
                    {
                        <td>@Html.DisplayFor(modelItem => item.LastUpdate)</td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Controls -->
    <div class="pagination justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewData["CurrentFilter"] }),
                 new PagedListRenderOptions
        {
            UlElementClasses = new List<string> { "pagination" },
            LiElementClasses = new List<string> { "page-item" },
            PageClasses = new List<string> { "page-link" }
        })
    </div>
</div>