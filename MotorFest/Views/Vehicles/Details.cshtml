@model MotorFest.Models.Vehicle.VehicleViewModel
@{
	ViewData["Title"] = "Details";
    bool isVehicleInFutureEvents = (bool)ViewData["CarIsInEvent"];
}
<div class="container mt-5">
	<h2 class="mb-4">Детайли за МПС</h2>
	<div class="card">
		<div class="card-body">
			<h5 class="card-title">@Model.Manufacturer</h5>
			<p class="card-text"><strong>Модел:</strong> @Model.Model</p>
			<p class="card-text"><strong>Година на производство:</strong> @Model.YearOfManufacture</p>
			<div class="card-img">
				<strong>Снимка:</strong>
				<img src="@Model.Photo" alt="Снимка на МПС" class="img-thumbnail small-image" />
			</div>
			<p class="card-text"><strong>Категория:</strong> @Model.Category.Name</p>
			<p class="card-text"><strong>Използвано гориво:</strong> @Model.EngineType.Name</p>
            @if (!isVehicleInFutureEvents)
            {
                
			<a asp-action="Edit" asp-route-id="@Model.Id" class="btn custom-primary-btn">Редактирай</a>
            }
			<a asp-action="Index" class="btn custom-primary-btn">Назад към списъка</a>
		</div>
	</div>
</div>

